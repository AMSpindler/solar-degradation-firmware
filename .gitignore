.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Auto-generated per-environment sdkconfig; keep sdkconfig.defaults tracked.
sdkconfig.*
!sdkconfig.defaults

# Captured measurement data. /data/ (raw capture dumps) stays ignored, but the
# curated csv/ analysis set (bench CSVs + MATLAB plot) is tracked on purpose.
/data/
*.DS_Store

# Python bytecode cache from the receiver/analysis tools.
__pycache__/
*.pyc

# Build-generated component manager lock file + editor workspace.
dependencies.lock
*.code-workspace
